# =========================================================================
# DEV ENVIRONMENT CONFIGURATION FOR VERCEL (dev.trinetraedu-ai.com)
# Copy these keys into your Vercel Project Environment Variables
# =========================================================================

# 1. Supabase Cloned DB Keys (different from production project)
NEXT_PUBLIC_SUPABASE_URL=https://xsjnaywzsitwlvekhrcx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-cloned-db-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-cloned-db-service-role-key

# 2. FastAPI Backend Router for Dev
# Point this to your separately hosted dev backend server (e.g. on Render or a VPS)
# Do NOT point it to localhost on Vercel
NEXT_PUBLIC_BACKEND_URL=https://your-dev-backend-api.com
NEXT_PUBLIC_FASTAPI_URL=https://your-dev-backend-api.com
NEXT_PUBLIC_PROCESSOR_API_URL=https://your-dev-backend-api.com/api/process-document

# 3. Communications & Integrations for Dev
NEXT_PUBLIC_SITE_URL=https://dev.trinetraedu-ai.com
NEXT_PUBLIC_RETELL_PUBLIC_KEY=your-retell-public-key
NEXT_PUBLIC_RETELL_AGENT_ID=your-retell-agent-id
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
RESEND_PRIVATE_KEY=re_your_resend_private_key
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# 4. Security & Administration
NEXT_PUBLIC_CSP_REPORT_ONLY=true
ADMIN_PASSWORD=your-secure-admin-password
