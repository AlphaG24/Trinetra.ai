# =========================================================================
# Supabase Configuration
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =========================================================================
# FastAPI Backend Configuration
# =========================================================================
# The base URL of the FastAPI backend router
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Endpoint for processing and structuring documents
NEXT_PUBLIC_PROCESSOR_API_URL=http://localhost:8000/api/process-document

# =========================================================================
# Voice & Agent Integrations (Vapi / Retell)
# =========================================================================


NEXT_PUBLIC_RETELL_PUBLIC_KEY=your-retell-public-key
NEXT_PUBLIC_RETELL_AGENT_ID=your-retell-agent-id

# =========================================================================
# Communications & Contacts
# =========================================================================
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
RESEND_PRIVATE_KEY=re_your_resend_private_key
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# =========================================================================
# Administration & Site Configuration
# =========================================================================
# SECURITY WARNING: NEVER use NEXT_PUBLIC_ for secrets! It exposes them to
# every browser client. Use ADMIN_PASSWORD (without NEXT_PUBLIC_ prefix).
ADMIN_PASSWORD=your-secure-admin-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_COOKIE_DOMAIN=.trinetraedu-ai.com

# =========================================================================
# Webhook Security
# =========================================================================
BROADCAST_WEBHOOK_SECRET=your-broadcast-webhook-secret
NEXT_PUBLIC_CSP_REPORT_ONLY=true

# =========================================================================
# Razorpay Payment Gateway & Subscriptions / Mandates
# =========================================================================
# 1. API Keys from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 2. Webhook Secret (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Recurring Subscription Plan IDs (Subscriptions > Plans)
# Create recurring monthly plans in Razorpay and paste their plan IDs here:
RAZORPAY_STARTER_PLAN_ID=plan_starter_monthly_id
RAZORPAY_PROFESSIONAL_PLAN_ID=plan_professional_monthly_id
